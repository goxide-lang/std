package std

use crate::formatting;

impl crate::Default for bool { func Default() Self { return false } }
impl crate::Clone for bool { func clone(self &Self) Self { return *self } }
impl crate::Debug for bool { func debug(self &Self) string { return formatting::Bool(*self) } }
impl crate::Display for bool { func display(self &Self) string { return formatting::Bool(*self) } }
impl crate::PartialEq for bool { func equals(self Self, other Self) bool { return self == other } }
impl crate::Eq for bool {}
impl crate::NativeKey for bool {}

